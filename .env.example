# Dev (5070) example — copy to .env (gitignored)
COMFY_URL=http://127.0.0.1:8188
# Folder of your ComfyUI install (informational: shown in the health check)
COMFY_ROOT=
SKIP_DIFFUSION=0
# GPU for the ComfyUI process (used by scripts that launch Comfy; synthguard does
# not export it into its own process, so training is steered by TRAIN_DEVICES).
CUDA_VISIBLE_DEVICES=0
SYNTHGUARD_DATA_ROOT=./data
GEN_PROFILE=dev_5070
# Physical GPU index for YOLO training ("cpu" also works). Dev: share GPU 0, run serially.
TRAIN_DEVICES=0
# Optional Hugging Face mirror, e.g. https://hf-mirror.com
# HF_ENDPOINT=
# Deploy later:
# GEN_PROFILE=deploy_3090
# CUDA_VISIBLE_DEVICES=0
# TRAIN_DEVICES=1
